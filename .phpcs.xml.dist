<?xml version="1.0"?>
<ruleset name="Easy Categories Shift64 Security">
	<description>WordPress security-focused coding standards for Easy Categories Shift64.</description>

	<!-- Scan plugin root file and includes/ directory -->
	<file>easy-categories-shift64.php</file>
	<file>includes/</file>

	<!-- Exclude third-party code -->
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>

	<!-- PHP version compatibility -->
	<config name="testVersion" value="8.0-"/>
	<config name="minimum_wp_version" value="6.8"/>

	<!-- Show progress and use colors -->
	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<!-- WordPress Security sniffs -->
	<rule ref="WordPress.Security.EscapeOutput"/>
	<rule ref="WordPress.Security.NonceVerification"/>
	<rule ref="WordPress.Security.ValidatedSanitizedInput"/>

	<!-- Database safety -->
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.DirectDatabaseQuery"/>

	<!-- PHP safety -->
	<rule ref="WordPress.PHP.DevelopmentFunctions"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
	<rule ref="WordPress.PHP.NoSilencedErrors"/>

	<!-- PHP Compatibility -->
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
